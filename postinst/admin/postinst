check_pycharm() {
  local version cmd
  echo -n "Checking pycharm ("
  cmd="$(find /opt/pycharm/bin/pycharm.sh /opt/pycharm-*/bin/pycharm.sh 2>/dev/null | head -n 1)"
  if [[ -z "$cmd" ]]; then
    echo "NOT FOUND"
    false
  else
    echo -n "$cmd)... "
    version="$($cmd --version | grep "PyCharm" | grep -Po "\d+\.\d+\.\d+")"
    check_version "$version" "2023.3.3"
  fi
}

